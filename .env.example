# =====================================================================
# Online Banking DevOps Platform - LOCAL DEVELOPMENT environment template
# ---------------------------------------------------------------------
# Copy to .env (which is git-ignored) and replace every CHANGE_ME value:
#     cp .env.example .env
# These values are for local Docker Compose ONLY. In AWS, secrets come
# from AWS Secrets Manager - never from this file.
# =====================================================================

# ---------- General ----------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Ports (host side) ----------
FRONTEND_PORT=3000
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=4001
ACCOUNT_SERVICE_PORT=4002
TRANSACTION_SERVICE_PORT=4003
NOTIFICATION_SERVICE_PORT=4004

# ---------- PostgreSQL (one server, one database + one user per service) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME

AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=CHANGE_ME

ACCOUNT_DB_NAME=account_db
ACCOUNT_DB_USER=account_user
ACCOUNT_DB_PASSWORD=CHANGE_ME

TRANSACTION_DB_NAME=transaction_db
TRANSACTION_DB_USER=transaction_user
TRANSACTION_DB_PASSWORD=CHANGE_ME

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=CHANGE_ME

# ---------- RabbitMQ ----------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=banking
RABBITMQ_PASSWORD=CHANGE_ME
RABBITMQ_EXCHANGE=banking.events

# ---------- Authentication ----------
# Access tokens are signed with RS256. Generate a local key pair with
#   scripts/generate-dev-keys.sh   (added in Phase 2)
# The private key is used ONLY by auth-service; all other services get
# only the public key.
JWT_ISSUER=online-banking-auth
JWT_AUDIENCE=online-banking-api
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem

# Shared secret for service-to-service calls on /internal routes
INTERNAL_SERVICE_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# ---------- API Gateway ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ---------- Simulation ----------
# Opening balance credited to every new simulated account (minor units: 100000 = 1,000.00)
DEMO_OPENING_BALANCE_MINOR=100000
DEFAULT_CURRENCY=USD
